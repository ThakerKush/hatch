# Your base domain — set wildcard DNS (*.yourdomain.com) pointing to this server's public IP
HATCH_BASE_DOMAIN=yourdomain.com

# Email for Let's Encrypt certificate registration
ACME_EMAIL=you@yourdomain.com

# Cloudflare API token for DNS challenge (wildcard certs)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone > DNS > Edit
CF_DNS_API_TOKEN=your-cloudflare-api-token
