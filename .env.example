# Postgres database
DATABASE_URL=postgres://hatch:hatch@127.0.0.1:5432/hatch?sslmode=disable

# Base domain
HATCH_BASE_DOMAIN=hatchvm.com

# HTTP API
HATCH_HTTP_ADDR=127.0.0.1:8080
HATCH_MAX_VMS_PER_USER=5
HATCH_MAX_SNAPSHOTS_PER_VM=10
# Better Auth API key verify endpoint used by hatchd middleware
HATCH_BETTER_AUTH_VERIFY_URL=http://127.0.0.1:3000/api/auth/api-key/verify

# Reverse proxy
HATCH_PROXY_ADDR=127.0.0.1:9090
# domain suffix for VM subdomain routing (my-agent.hatch.local → VM)
HATCH_PROXY_BASE_DOMAIN=${HATCH_BASE_DOMAIN}
HATCH_DATA_DIR=/data
HATCH_S3_ENDPOINT=http://127.0.0.1:9000
HATCH_S3_BUCKET=hatch-snapshots
HATCH_S3_REGION=us-east-1
HATCH_S3_ACCESS_KEY=minioadmin
HATCH_S3_SECRET_KEY=minioadmin
# Firecracker binary
HATCH_FIRECRACKER_BIN=/root/firecracker/firecracker
# Default kernel and rootfs paths
HATCH_DEFAULT_KERNEL_PATH=/root/firecracker/vmlinux-5.10
HATCH_DEFAULT_ROOTFS_PATH=/root/firecracker/ubuntu-noble-rootfs.ext4
# Per-VM writable overlay image size in MiB
HATCH_MAX_OVERLAY_SIZE_MIB=2048
# SSH forwarding allowed CIDR
HATCH_SSH_ALLOWED_CIDR=0.0.0.0/0
# SSH Certificate Authority for platform-level VM access
# Generate with: ssh-keygen -t ed25519 -f hatch-ca -N "" -C "hatch-platform-ca"
HATCH_SSH_CA_PRIVATE_KEY_PATH=/path/to/hatch-ca
HATCH_SSH_CA_PUBLIC_KEY_PATH=/path/to/hatch-ca.pub
# Idle timeout
HATCH_IDLE_TIMEOUT=45m
# Idle check interval
HATCH_IDLE_CHECK_INTERVAL=15m

# Better Auth (web/)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
HATCH_API_BASE_URL=http://127.0.0.1:8080