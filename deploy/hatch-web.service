[Unit]
Description=Hatch web (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/hatch/web
EnvironmentFile=/root/hatch/.env
# Use the shell so PATH is resolved — works with fnm/nvm/system node
ExecStart=/usr/local/bin/pnpm start
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
